{
  "name": "kubernetes-learning-playground",
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "tsx cli/index.ts start",
    "cli": "tsx cli/index.ts",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain/*.test.ts tests/server/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib cli tests *.json *.ts *.mjs",
    "package:build": "node scripts/clean-package.mjs && next build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/postcss": "4.3.3",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "jose": "6.2.12",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.3",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.1",
    "zod": "^4.3.6",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "bin": {
    "waypoint": "dist/cli/index.cjs"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "files": [
    "dist/cli",
    "dist/ui",
    "examples/local-http",
    "SETUP.md"
  ]
}
